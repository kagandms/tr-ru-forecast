# ==============================================================================
# Environment Configuration Template (.env.example)
# TR-RU Bilateral Trade Forecasting & Intelligence Platform
# ==============================================================================
# NOTE: Copy this file to .env and fill in real values. Never commit .env to Git.

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Database / Storage (Placeholders for future milestones)
DATABASE_URL=postgresql://user:password@localhost:5432/tr_ru_forecast
SUPABASE_URL=
SUPABASE_KEY=

# Data Ingestion Source APIs (Placeholders for future milestones)
COMTRADE_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
